{
  "manifest_version": 3,
  "name": "OneNote Quick Save",
  "version": "1.3.1",
  "description": "Save selected content to the local OneNote desktop app.",
  "browser_specific_settings": {
    "gecko": {
      "id": "onenote-quick-save@example.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    }
  },
  "permissions": ["activeTab", "scripting", "nativeMessaging", "contextMenus", "storage", "notifications"],
  "background": {
    "scripts": ["i18n.js", "background.js"]
  },
  "action": {
    "default_title": "OneNote Quick Save",
    "default_popup": "popup.html"
  },
  "icons": {
    "48": "icons/onenote.svg"
  }
}
